# Demonstration of Class and Object

class Student:
    # Constructor
    def __init__(self, name, age):
        self.name = name
        self.age = age

    # Method
    def display(self):
        print("Student Name:", self.name)
        print("Student Age:", self.age)


# Creating an object
student1 = Student("Rahul", 20)

# Calling the method
student1.display()