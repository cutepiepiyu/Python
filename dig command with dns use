
import subprocess

domain = input("Enter Domain Name: ")

# Find IPv4 address
print("\nIP Address:")

result = subprocess.run(
    ["dig", "+short", domain, "A"],
    capture_output=True,
    text=True
)

print(result.stdout if result.stdout else "IP not found")

# Display DNS records
records = ["A", "AAAA", "MX", "NS", "TXT", "CNAME"]

print("\nDNS Records:")

for record in records:
    print("\n" + record + " Record:")

    result = subprocess.run(
        ["dig", "+short", domain, record],
        capture_output=True,
        text=True
    )

    if result.stdout.strip():
        print(result.stdout)
    else:
        print("No record found")
