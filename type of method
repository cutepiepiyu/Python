# Demonstration of Types of Methods in Python

class Student:

    school = "Marwadi University"      

    # Constructor
    def __init__(self, name, marks):
        self.name = name
        self.marks = marks

    # 1. Instance Method
    def display(self):
        print("Name:", self.name)
        print("Marks:", self.marks)

    # 2. Class Method
    @classmethod
    def show_school(cls):
        print("School:", cls.school)

    # 3. Static Method
    @staticmethod
    def greet():
        print("Welcome to Python Class")


# Create Object
s1 = Student("Rahul", 85)

# Call Instance Method
s1.display()

# Call Class Method
Student.show_school()

# Call Static Method
Student.greet()