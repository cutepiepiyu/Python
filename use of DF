import pandas as pd

# Create a DataFrame
data = {
    'Name': ['Priya', 'Jigna', 'Ravi', 'Amit'],
    'Age': [22, 23, 21, 24],
    'City': ['Ahmedabad', 'Rajkot', 'Mumbai', 'Surat']
}

df = pd.DataFrame(data)

# Display DataFrame
print("Student DataFrame:")
print(df)

# Display specific column
print("\nStudent Names:")
print(df['Name'])

# Display first two records
print("\nFirst Two Records:")
print(df.head(2))

# Display DataFrame information
print("\nDataFrame Information:")
print(df.info())

"""Types of creating the DataFrame:"""

# 1. Creating DataFrame using Dictionary
data1 = {
    'Name': ['Priya', 'Jigna', 'Ravi'],
    'Age': [22, 23, 21]
}

df1 = pd.DataFrame(data1)
print("DataFrame using Dictionary:")
print(df1)


# 2. Creating DataFrame using List
data2 = [
    ['Priya', 22],
    ['Jigna', 23],
    ['Ravi', 21]
]

df2 = pd.DataFrame(data2, columns=['Name', 'Age'])
print("\nDataFrame using List:")
print(df2)


# 3. Creating DataFrame using List of Dictionaries
data3 = [
    {'Name': 'Priya', 'City': 'Ahmedabad'},
    {'Name': 'Jigna', 'City': 'Rajkot'},
    {'Name': 'Ravi', 'City': 'Mumbai'}
]

df3 = pd.DataFrame(data3)
print("\nDataFrame using List of Dictionaries:")
print(df3)
